{
  "name": "ironfront",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/api/src/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --import tsx apps/api/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "format": "prettier --write apps packages tests scripts vite.config.ts",
    "test:fronts": "node --import tsx scripts/fronts-browser.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.3",
    "@fontsource/barlow-condensed": "^5.3.0",
    "d3-delaunay": "^6.0.4",
    "fastify": "^5.0.0",
    "pixi.js": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "earcut": "^3.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/d3-delaunay": "^6.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
